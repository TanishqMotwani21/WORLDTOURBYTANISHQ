# ==========================================================
# AI Title Verification — Prototype environment template
# NOTHING here is required. Core verification runs fully offline.
# ==========================================================

# --- storage ---
# TV_DATA_DIR=./data
# TV_DB_PATH=./data/titles.db

# --- semantic engine: auto | st | demo ---
# auto = use sentence-transformers when installed, else demo concept lexicon
# TV_SEMANTIC_ENGINE=auto
# TV_ST_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- prototype demonstration weights (must sum to 1.0) ---
# TV_W_STRING=0.25
# TV_W_PHONETIC=0.20
# TV_W_SEMANTIC=0.35
# TV_W_RULES=0.10
# TV_W_OVERLAP=0.10

# --- prototype demonstration thresholds (0-100) ---
# TV_T_REVIEW=36
# TV_T_HIGH=66

# --- demo rule engine (JSON list; DEMO terms only, not official PRGI policy) ---
# TV_DISALLOWED=["president","government","police"]

# --- retrieval ---
# TV_TOP_K=25
# TV_MAX_MATCHES=9

# --- title constraints (demo policy) ---
# TV_MIN_LEN=3
# TV_MAX_LEN=80

# --- CORS (comma-separated origins; default permissive for local demo) ---
# TV_CORS_ORIGINS=http://localhost:5173

# --- OPTIONAL external AI assistant (NEVER required by the core engine) ---
# If set, future narrative-explanation features may use it; the prototype does
# not depend on it for any verification function.
# GEMINI_API_KEY=
